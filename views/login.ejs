<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log in</title>
    <link rel="stylesheet" href="/stylesheets/login/index.css">
    <link rel="stylesheet" href="/stylesheets/notification/index.css">
</head>

<body>
    <%- include('notification/notification.ejs') %>

    <main class="auth-page">
        <section class="auth-form-side">
            <div class="auth-form-wrap">
                <h1>Welcome back!</h1>
                <h2>Enter your Credentials to access your account</h2>
                <form>
                    <label for="email">Email address</label>
                    <input id="email" type="email" name="email"placeholder="Enter your email" required>
                    <div class="label-row"><label for="password">Password</label><a href="#">forgot password</a></div>
                    <input id="password" type="password" name="password" placeholder="Enter your password"required>
                    <button class="primary-button" type="submit">Login</button>
                </form>
                <p class="switch-text">Don't have an account? <a href="/">Sign Up</a></p>
            </div>
        </section>
        <section class="auth-image-side"><img src="/images/plant.jpg" alt="Green tropical plant"></section>
    </main>
    <script src="/javascripts/login/index.js"></script>
    <script src="/javascripts/notification/index.js"></script>
</body>

</html>
