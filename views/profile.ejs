<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Profile</title>
    <link rel="stylesheet" href="/stylesheets/profile/index.css" />
    <link rel="stylesheet" href="/stylesheets/notification/index.css" />
  </head>
  <body>
    <%- include('notification') %>
    <main class="profile-page">
      <section class="profile-card">
        <div class="avatar">U</div>
        <h1 class="user-name">User</h1>
        <div class="profile-info">
          <p><span>Name</span><strong class="user-name">—</strong></p>
          <p><span>Email</span><strong class="user-email">—</strong></p>
          <p><span>ID</span><strong class="user-id">—</strong></p>
        </div>
        <button id="logout" type="button">Logout</button>
      </section>
    </main>
    <script src="/javascripts/profile/index.js"></script>
    <script src="/javascripts/notification/index.js"></script>
  </body>
</html>
